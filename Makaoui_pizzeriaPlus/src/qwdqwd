public void scriviStringa(RandomAccessFile archivio, int lenght, String nome) throws IOException {
    StringBuilder sb = new StrinBuilder(nome);
    sb.setLenght(lenght);
    archivio.writeBytes(sb.toString());
}

public String leggiStringa(RandomAccessFile archivio, int lenght) throws IOException {
    byte[] b = new Byte[];
    b.fullyRead(archivio);
    return new String(b).trim();
}

